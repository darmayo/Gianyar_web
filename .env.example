# ============================================================
# SALIN FILE INI KE .env DAN ISI NILAINYA
# JANGAN COMMIT .env KE GIT
# ============================================================

# === DATABASE ===
DATABASE_URL="postgresql://gianyar_user:GANTI_PASSWORD_KUAT@localhost:5432/gianyar_db"
DATABASE_URL_REPLICA="postgresql://gianyar_user:GANTI_PASSWORD_KUAT@localhost:5433/gianyar_db"

# === REDIS ===
REDIS_URL="redis://:GANTI_REDIS_PASSWORD@localhost:6379"

# === NEXTAUTH ===
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GENERATE_DENGAN: openssl rand -base64 32"

# === JWT (API) ===
JWT_SECRET="GENERATE_DENGAN: openssl rand -base64 64"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# === FILE STORAGE (MinIO) ===
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="GANTI_ACCESS_KEY"
MINIO_SECRET_KEY="GANTI_SECRET_KEY"
MINIO_BUCKET_DOCS="gianyar-documents"
MINIO_BUCKET_PUBLIC="gianyar-public"

# === EMAIL (SMTP) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@gianyarkab.go.id"
SMTP_PASS="GANTI_APP_PASSWORD"
SMTP_FROM="Pemkab Gianyar <noreply@gianyarkab.go.id>"

# === WHATSAPP (Fonnte/Wablas API) ===
WA_API_URL="https://api.fonnte.com/send"
WA_API_TOKEN="GANTI_TOKEN_WHATSAPP"

# === ENKRIPSI DATA NIK ===
NIK_ENCRYPTION_KEY="GENERATE_DENGAN: openssl rand -hex 32"

# === CLOUDFLARE (Production) ===
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

# === APP CONFIG ===
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Portal Kabupaten Gianyar"
NEXT_PUBLIC_API_URL="http://localhost:4000"
