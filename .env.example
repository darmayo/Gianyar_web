# ============================================================
# SALIN FILE INI KE .env DAN ISI NILAINYA
# JANGAN COMMIT .env KE GIT
# ============================================================

# === DATABASE ===
POSTGRES_PASSWORD="GENERATE_DENGAN: openssl rand -base64 32"
DATABASE_URL="postgresql://gianyar_user:GANTI_PASSWORD_KUAT@localhost:5432/gianyar_db"
DATABASE_URL_REPLICA="postgresql://gianyar_user:GANTI_PASSWORD_KUAT@localhost:5433/gianyar_db"
DB_POOL_MAX="10"

# === REDIS ===
REDIS_PASSWORD="GENERATE_DENGAN: openssl rand -base64 32"
REDIS_URL="redis://:GANTI_REDIS_PASSWORD_SAMA_DENGAN_REDIS_PASSWORD@localhost:6379"

# === NEXTAUTH ===
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GENERATE_DENGAN: openssl rand -base64 32"
ADMIN_SESSION_SECRET="GENERATE_DENGAN: openssl rand -base64 32"
ADMIN_BOOTSTRAP_EMAIL="admin@gianyarkab.go.id"
ADMIN_BOOTSTRAP_PASSWORD="GANTI_PASSWORD_ADMIN_MIN_12_CHAR"

# === JWT (API) ===
JWT_SECRET="GENERATE_DENGAN: openssl rand -base64 64"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# === FILE STORAGE (MinIO) ===
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="GENERATE_DENGAN: openssl rand -hex 16"
MINIO_SECRET_KEY="GENERATE_DENGAN: openssl rand -base64 32"
MINIO_BUCKET_DOCS="gianyar-documents"
MINIO_BUCKET_PUBLIC="gianyar-public"
PRIVATE_STORAGE_ROOT="/var/lib/gianyar/private"

# === EMAIL (SMTP) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@gianyarkab.go.id"
SMTP_PASS="GANTI_APP_PASSWORD"
SMTP_FROM="Pemkab Gianyar <noreply@gianyarkab.go.id>"
NOTIFICATION_WORKER_BATCH="20"

# === WHATSAPP (Fonnte/Wablas API) ===
WA_API_URL="https://api.fonnte.com/send"
WA_API_TOKEN="GANTI_TOKEN_WHATSAPP"

# === ENKRIPSI DATA NIK ===
NIK_HASH_PEPPER="GENERATE_DENGAN: openssl rand -base64 32"
NIK_ENCRYPTION_KEY="GENERATE_DENGAN: openssl rand -hex 32"

# === LOGGING INTERNAL ===
LOG_SECRET="GENERATE_DENGAN: openssl rand -base64 32"
LOG_INGEST_TOKEN="GENERATE_DENGAN: openssl rand -base64 32"
LOG_MAX_FILE_MB="5"

# === CLOUDFLARE (Production) ===
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

# === APP CONFIG ===
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Portal Kabupaten Gianyar"
NEXT_PUBLIC_API_URL="http://localhost:4000"
