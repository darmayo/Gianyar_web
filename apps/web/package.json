{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build --webpack && node scripts/strip-fingerprint.mjs",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "postinstall": "node scripts/apply-patches.mjs",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "notifications:worker": "node scripts/notification-worker.mjs",
    "notifications:worker:dry-run": "node scripts/notification-worker.mjs --dry-run",
    "smoke:minio": "node scripts/minio-smoke.mjs",
    "smoke:smtp": "node scripts/smtp-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@hookform/resolvers": "^3.9.1",
    "@types/leaflet": "^1.9.21",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "next": "^16.2.3",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "redis": "^5.10.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
